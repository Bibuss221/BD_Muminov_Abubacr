QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QPushButton {
    padding: 6px 12px;
}

QTableView {
    background: #ffffff;
    color: #202020;
    gridline-color: #d9d9d9;
    selection-background-color: #dbeafe;
    selection-color: #202020;
}

QHeaderView::section {
    background: #f2f2f2;
    color: #202020;
    padding: 5px;
    border: 1px solid #d9d9d9;
}

QLineEdit {
    background: #ffffff;
    color: #202020;
}

QLabel {
    color: #202020;
}

QStatusBar {
    color: #202020;
}
